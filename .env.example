# Скопируйте в .env и заполните (ключи из Supabase проекта архива).
# Lovable в рантайме не используется — только ваша база Supabase.

# ВАШ проект из Dashboard → Settings → API (Project URL и publishable):
SUPABASE_URL=https://ВАШ_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Старый проект Lovable (если есть доступ): rycgzckzrxedsbpwvzbh
# Секретный ключ (любое имя — сервер понимает оба):
# Dashboard → Секретные ключи → sb_secret_...  ИЛИ вкладка «Устаревшие» → service_role eyJ...
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=sb_secret_...

# Служебный код для /staff (задайте свой):
STAFF_ACCESS_CODE=ARHIV-VKO-2026

PORT=8080
