@{
    ViewData["Title"] = "Тіркелу";
}

<section class="auth-shell">
    <form class="auth-card glass-card" asp-controller="Auth" asp-action="Register" method="post">
        <span class="eyebrow"><i class="bi bi-person-plus"></i> Registration</span>
        <h1 class="mt-3 fw-bold">Аккаунт ашу</h1>
        <p class="text-muted">Пайдаланушы профилін жасап, Archive Access System мүмкіндіктерін бастаңыз.</p>
        <div class="mb-3">
            <label class="form-label">Толық аты-жөні</label>
            <input class="form-control" name="fullName" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" name="email" type="email" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Ұйым</label>
            <input class="form-control" name="organization" />
        </div>
        <button class="btn btn-premium w-100" type="submit">Тіркелу</button>
        <p class="text-muted mt-3 mb-0">Аккаунт бар ма? <a asp-controller="Auth" asp-action="Login">Кіру</a></p>
    </form>
</section>
