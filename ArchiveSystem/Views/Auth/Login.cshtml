@{
    ViewData["Title"] = "Кіру";
}

<section class="auth-shell">
    <form class="auth-card glass-card" asp-controller="Auth" asp-action="Login" method="post">
        <span class="eyebrow"><i class="bi bi-box-arrow-in-right"></i> Secure login</span>
        <h1 class="mt-3 fw-bold">Жүйеге кіру</h1>
        <p class="text-muted">Демо үшін admin@archive.kz енгізіңіз. Жүйе cookie session және JWT preview жасайды.</p>
        @if (TempData["AuthMessage"] is string message)
        {
            <div class="alert alert-premium">@message</div>
        }
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" name="email" type="email" value="admin@archive.kz" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Құпия сөз</label>
            <input class="form-control" name="password" type="password" value="archive-demo" required />
        </div>
        <button class="btn btn-premium w-100" type="submit">Кіру</button>
        <div class="d-flex justify-content-between mt-3">
            <a asp-controller="Auth" asp-action="ForgotPassword">Құпия сөзді қалпына келтіру</a>
            <a asp-controller="Auth" asp-action="Register">Тіркелу</a>
        </div>
    </form>
</section>
