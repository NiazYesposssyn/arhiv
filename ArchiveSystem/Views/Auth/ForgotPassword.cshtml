@{
    ViewData["Title"] = "Восстановление пароля";
}

<section class="auth-shell">
    <form class="auth-card glass-card" asp-controller="Auth" asp-action="ForgotPassword" method="post">
        <span class="eyebrow"><i class="bi bi-key"></i> Recovery</span>
        <h1 class="mt-3 fw-bold">Құпия сөзді қалпына келтіру</h1>
        <p class="text-muted">Email енгізіңіз, жүйе қалпына келтіру нұсқаулығын жібереді.</p>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" name="email" type="email" required />
        </div>
        <button class="btn btn-premium w-100" type="submit">Нұсқаулық жіберу</button>
        <p class="text-muted mt-3 mb-0"><a asp-controller="Auth" asp-action="Login">Кіруге қайту</a></p>
    </form>
</section>
