@model ArchiveRequest
@{
    ViewData["Title"] = Model.Subject;
    ViewData["PageTitle"] = "Заявка карточкасы";
}

<div class="section-grid">
    <article class="premium-card">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <span class="badge-soft">@Model.Number</span>
                <h2 class="fw-bold mt-3">@Model.Subject</h2>
                <p class="muted">@Model.Description</p>
            </div>
            <span class="badge-soft">@Model.Status</span>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="p-3 rounded-4 bg-primary bg-opacity-10"><div class="muted small">Пайдаланушы</div><strong>@Model.RequestedBy?.FullName</strong></div></div>
            <div class="col-md-4"><div class="p-3 rounded-4 bg-warning bg-opacity-10"><div class="muted small">Басымдық</div><strong>@Model.Priority</strong></div></div>
            <div class="col-md-4"><div class="p-3 rounded-4 bg-success bg-opacity-10"><div class="muted small">Мерзімі</div><strong>@Model.DueAt?.ToLocalTime().ToString("dd.MM.yyyy")</strong></div></div>
        </div>
        @if (Model.ArchiveDocument is not null)
        {
            <a class="btn btn-ghost" asp-controller="Documents" asp-action="Details" asp-route-id="@Model.ArchiveDocumentId">
                <i class="bi bi-file-earmark me-2"></i>@Model.ArchiveDocument.Number · @Model.ArchiveDocument.Title
            </a>
        }
    </article>

    <aside class="premium-card">
        <h3 class="h5 fw-bold">Әкімші түсіндірмесі</h3>
        @if (User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.Archivist))
        {
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-grid gap-3 mt-3">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<RequestStatus>()"></select>
                <textarea name="comment" class="form-control" rows="3" placeholder="Пайдаланушыға пікір..."></textarea>
                <button class="btn btn-premium" type="submit">Мәртебені жаңарту</button>
            </form>
        }
        <div class="timeline mt-4">
            @foreach (var comment in Model.Comments.OrderByDescending(x => x.CreatedAt))
            {
                <div class="timeline-item">
                    <div class="fw-bold">@comment.Author?.FullName</div>
                    <div>@comment.Message</div>
                    <div class="muted small">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </div>
            }
        </div>
    </aside>
</div>
