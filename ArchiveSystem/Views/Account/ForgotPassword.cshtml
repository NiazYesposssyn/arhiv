@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Құпиясөзді қалпына келтіру";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-hero">
            <h1 class="display-6 fw-bold">Қауіпсіз қалпына келтіру</h1>
            <p class="opacity-75">Email арқылы уақытша reset token жіберіледі.</p>
        </div>
        <div class="auth-form">
            <h2 class="fw-bold mb-4">Құпиясөзді қалпына келтіру</h2>
            <form asp-action="ForgotPassword" method="post" class="d-grid gap-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control form-control-lg" />
                <span asp-validation-for="Email" class="text-danger small"></span>
                <button class="btn btn-premium btn-lg" type="submit">Нұсқаулық жіберу</button>
                <a asp-action="Login">Кіру бетіне оралу</a>
            </form>
        </div>
    </div>
</div>
