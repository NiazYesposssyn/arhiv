@model LoginViewModel
@{
    ViewData["Title"] = "Кіру";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-hero">
            <span class="badge bg-light text-dark mb-4">Enterprise Archive Platform</span>
            <h1 class="display-5 fw-bold mb-3">Archive Access System</h1>
            <p class="lead opacity-75">Архивтік құжаттарды басқару, сұраныстарды өңдеу және аналитиканы бір қауіпсіз premium кеңістікте біріктіріңіз.</p>
            <div class="row g-3 mt-4">
                <div class="col-6"><div class="p-3 rounded-4 bg-white bg-opacity-10"><i class="bi bi-shield-check fs-3"></i><div class="fw-bold mt-2">JWT + 2FA</div></div></div>
                <div class="col-6"><div class="p-3 rounded-4 bg-white bg-opacity-10"><i class="bi bi-graph-up fs-3"></i><div class="fw-bold mt-2">Analytics</div></div></div>
            </div>
        </div>
        <div class="auth-form">
            <h2 class="fw-bold mb-2">Жүйеге кіру</h2>
            <p class="muted mb-4">Қауіпсіз жұмыс сессиясын бастау үшін аккаунтыңызбен кіріңіз.</p>
            <form asp-action="Login" method="post" class="d-grid gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div>
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="admin@archive.local" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Password" class="form-label fw-semibold">Құпиясөз</label>
                    <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-check-label"><input asp-for="RememberMe" class="form-check-input me-2" />Мені есте сақтау</label>
                    <a asp-action="ForgotPassword">Құпиясөзді ұмыттыңыз ба?</a>
                </div>
                <button class="btn btn-premium btn-lg" type="submit">Кіру</button>
                <p class="mb-0 muted">Аккаунт жоқ па? <a asp-action="Register">Тіркелу</a></p>
            </form>
            <div class="mt-4 p-3 rounded-4 bg-primary bg-opacity-10 small">
                Demo: <strong>admin@archive.local</strong> / <strong>Archive#2026</strong>
            </div>
        </div>
    </div>
</div>
