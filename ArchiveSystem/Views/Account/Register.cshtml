@model RegisterViewModel
@{
    ViewData["Title"] = "Тіркелу";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-hero">
            <h1 class="display-6 fw-bold">Жаңа пайдаланушы кеңістігі</h1>
            <p class="opacity-75">Өтінімдер тарихы, хабарламалар және архивтік құжаттарға бақыланатын қолжетімділік.</p>
        </div>
        <div class="auth-form">
            <h2 class="fw-bold mb-4">Аккаунт құру</h2>
            <form asp-action="Register" method="post" class="d-grid gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div>
                    <label asp-for="FullName" class="form-label">Аты-жөні</label>
                    <input asp-for="FullName" class="form-control form-control-lg" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Department" class="form-label">Бөлім</label>
                    <input asp-for="Department" class="form-control form-control-lg" />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control form-control-lg" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">Құпиясөз</label>
                        <input asp-for="Password" class="form-control form-control-lg" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">Қайталау</label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
                    </div>
                </div>
                <button class="btn btn-premium btn-lg" type="submit">Тіркелу</button>
                <a asp-action="Login">Кіру бетіне оралу</a>
            </form>
        </div>
    </div>
</div>
