<!DOCTYPE html>
<html lang="kk" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Archive Access System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-shell">
    <div class="page-loader" aria-label="Loading">
        <div class="loader-orb"></div>
    </div>

    <nav class="navbar navbar-expand-xl premium-navbar fixed-top">
        <div class="container-fluid container-xxl">
            <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-archive"></i></span>
                <span>Archive Access</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto gap-xl-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Басты бет</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Archive">Архив туралы</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Services">Қызметтер</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Pricing">Тарифтер</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Analytics" asp-action="Index">Аналитика</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contacts">Байланыс</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="HelpCenter">Көмек</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Тағы</a>
                        <ul class="dropdown-menu glass-dropdown">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="AboutSystem">О системе</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="News">Новости</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Faq">FAQ</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Privacy">Политика</a></li>
                        </ul>
                    </li>
                </ul>
                <div class="nav-actions">
                    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme"><i class="bi bi-moon-stars"></i></button>
                    <a class="btn btn-ghost" asp-controller="Auth" asp-action="Login">Кіру</a>
                    <a class="btn btn-premium" asp-controller="Auth" asp-action="Register">Тіркелу</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="page-transition">
        @RenderBody()
    </main>

    <footer class="footer-premium">
        <div class="container-xxl">
            <div class="row g-4 align-items-start">
                <div class="col-lg-5">
                    <div class="brand-mark mb-3">
                        <span class="brand-icon"><i class="bi bi-archive"></i></span>
                        <span>Archive Access System</span>
                    </div>
                    <p class="text-muted mb-0">Интеллектуальная платформа для безопасного хранения архивных данных, обработки онлайн-сұраныстар және аналитики.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Платформа</h6>
                    <a asp-controller="Home" asp-action="AboutSystem">О системе</a>
                    <a asp-controller="Home" asp-action="Archive">Архив</a>
                    <a asp-controller="Home" asp-action="Pricing">Тарифы</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Қолдау</h6>
                    <a asp-controller="Home" asp-action="HelpCenter">Справочный центр</a>
                    <a asp-controller="Home" asp-action="Faq">FAQ</a>
                    <a asp-controller="Home" asp-action="Contacts">Контакты</a>
                </div>
                <div class="col-lg-3">
                    <h6>Enterprise ready</h6>
                    <div class="security-strip"><i class="bi bi-shield-check"></i> JWT, RBAC, audit logs, backups</div>
                </div>
            </div>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-4">
        <div id="appToast" class="toast premium-toast" role="status" aria-live="polite" aria-atomic="true">
            <div class="toast-header">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Archive Access</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">Операция орындалды.</div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
