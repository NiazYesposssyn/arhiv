@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var user = signedIn ? await UserManager.GetUserAsync(User) : null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var toast = TempData["Toast"] as string;
    string IsActive(string controller) => currentController == controller ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="kk" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Archive Access System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    @if (signedIn)
    {
        <aside class="app-sidebar glass-panel">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-shield-lock"></i></span>
                <span>
                    <strong>Archive Access</strong>
                    <small>Intelligent Archive OS</small>
                </span>
            </a>
            <nav class="sidebar-nav">
                <a class="@IsActive("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Басқару панелі</span></a>
                <a class="@IsActive("Documents")" asp-controller="Documents" asp-action="Index"><i class="bi bi-file-earmark-richtext"></i><span>Құжаттар</span></a>
                <a class="@IsActive("Requests")" asp-controller="Requests" asp-action="Index"><i class="bi bi-inboxes"></i><span>Заявкалар</span></a>
                <a class="@IsActive("Analytics")" asp-controller="Analytics" asp-action="Index"><i class="bi bi-bar-chart"></i><span>Аналитика және карта</span></a>
                @if (User.IsInRole(RoleNames.Administrator))
                {
                    <a class="@IsActive("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i><span>Пайдаланушылар</span></a>
                    <a class="@IsActive("AuditLogs")" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text"></i><span>Аудит журналы</span></a>
                    <a class="@IsActive("Settings")" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders"></i><span>Баптаулар</span></a>
                }
                <a class="@IsActive("Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i><span>Хабарламалар</span></a>
                <a class="@IsActive("Profile")" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i><span>Профиль</span></a>
            </nav>
            <div class="sidebar-card">
                <span class="pulse-dot"></span>
                <strong>Қауіпсіз режим</strong>
                <small>JWT, RBAC, 2FA және аудит қосылған</small>
            </div>
        </aside>
    }

    <main class="app-main @(signedIn ? string.Empty : "auth-main")">
        @if (signedIn)
        {
            <header class="topbar glass-panel">
                <div>
                    <div class="breadcrumb-line">
                        <span>Archive Access System</span>
                        <i class="bi bi-chevron-right"></i>
                        <span>@currentController</span>
                        @if (!string.IsNullOrWhiteSpace(currentAction))
                        {
                            <i class="bi bi-chevron-right"></i>
                            <span>@currentAction</span>
                        }
                    </div>
                    <h1>@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Басқару панелі")</h1>
                </div>
                <div class="topbar-actions">
                    <form asp-controller="Culture" asp-action="Set" method="post" class="language-form">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <select name="culture" onchange="this.form.submit()" class="form-select form-select-sm">
                            <option value="kk-KZ">Қазақша</option>
                            <option value="ru-RU">Русский</option>
                            <option value="en-US">English</option>
                        </select>
                    </form>
                    <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle theme"><i class="bi bi-moon-stars"></i></button>
                    <a class="icon-btn" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i></a>
                    <div class="user-chip">
                        <span class="avatar">@((user?.FullName ?? "A").Substring(0, 1))</span>
                        <span class="d-none d-md-flex flex-column">
                            <strong>@user?.FullName</strong>
                            <small>@user?.Department</small>
                        </span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-sm btn-outline-light logout-btn" type="submit"><i class="bi bi-box-arrow-right"></i></button>
                    </form>
                </div>
            </header>
        }

        <section class="content-shell">
            @RenderBody()
        </section>
    </main>

    @if (!string.IsNullOrWhiteSpace(toast))
    {
        <div class="toast-container position-fixed top-0 end-0 p-4">
            <div class="toast show premium-toast" role="alert">
                <div class="toast-body"><i class="bi bi-check2-circle"></i> @toast</div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
