<!DOCTYPE html>
<html lang="kk" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Archive Console</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-shell">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <a class="brand-mark mb-4" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-archive"></i></span>
                <span>Archive Console</span>
            </a>
            <nav class="admin-menu">
                <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                <a asp-controller="Documents" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Documents</a>
                <a asp-controller="Requests" asp-action="Index"><i class="bi bi-inbox"></i> Requests</a>
                <a asp-controller="Analytics" asp-action="Index"><i class="bi bi-bar-chart"></i> Analytics</a>
                <a asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> Users</a>
                <a asp-controller="Admin" asp-action="Roles"><i class="bi bi-person-badge"></i> Roles</a>
                <a asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-clock-history"></i> Audit Logs</a>
                <a asp-controller="Admin" asp-action="Notifications"><i class="bi bi-bell"></i> Notifications</a>
                <a asp-controller="Admin" asp-action="Reports"><i class="bi bi-clipboard-data"></i> Reports</a>
                <a asp-controller="Admin" asp-action="Settings"><i class="bi bi-sliders"></i> Settings</a>
                <a asp-controller="Admin" asp-action="Profile"><i class="bi bi-person-circle"></i> Profile</a>
                <a asp-controller="Admin" asp-action="Support"><i class="bi bi-life-preserver"></i> Support Center</a>
                <a asp-controller="Admin" asp-action="ApiDocs"><i class="bi bi-code-slash"></i> API Documentation</a>
                <a asp-controller="Admin" asp-action="Backups"><i class="bi bi-database-lock"></i> Backups</a>
                <a asp-controller="Admin" asp-action="Security"><i class="bi bi-shield-lock"></i> Security Center</a>
            </nav>
        </aside>

        <section class="admin-main">
            <header class="admin-topbar">
                <div>
                    <span class="eyebrow">Archive Access System</span>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="topbar-actions">
                    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme"><i class="bi bi-moon-stars"></i></button>
                    <button class="btn btn-soft" data-toast="Жаңа хабарламалар тексерілді"><i class="bi bi-bell"></i></button>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button class="btn btn-premium" type="submit">Шығу</button>
                    </form>
                </div>
            </header>

            @if (TempData["PanelMessage"] is string message)
            {
                <div class="alert alert-premium fade-in" role="alert">@message</div>
            }

            <main class="admin-content page-transition">
                @RenderBody()
            </main>
        </section>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-4">
        <div id="appToast" class="toast premium-toast" role="status" aria-live="polite" aria-atomic="true">
            <div class="toast-header">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Archive Access</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">Операция орындалды.</div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
