@model ArchiveDocument
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageTitle"] = "Құжат паспорты";
}

<div class="section-grid">
    <article class="premium-card">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <span class="badge-soft mb-3">@Model.Number</span>
                <h2 class="fw-bold">@Model.Title</h2>
                <p class="muted">@Model.Description</p>
            </div>
            <span class="badge-soft">@Model.Status</span>
        </div>
        <div class="row g-3">
            <div class="col-md-4"><div class="p-3 rounded-4 bg-primary bg-opacity-10"><div class="muted small">Санат</div><strong>@Model.Category?.Name</strong></div></div>
            <div class="col-md-4"><div class="p-3 rounded-4 bg-info bg-opacity-10"><div class="muted small">Формат</div><strong>@Model.FileType</strong></div></div>
            <div class="col-md-4"><div class="p-3 rounded-4 bg-success bg-opacity-10"><div class="muted small">Көлемі</div><strong>@(Model.FileSizeBytes / 1024 / 1024) MB</strong></div></div>
        </div>
        <div class="mt-4 d-flex gap-2 flex-wrap">
            <a class="btn btn-premium" asp-action="Download" asp-route-id="@Model.Id"><i class="bi bi-download me-2"></i>Скачать</a>
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post">
                <button class="btn btn-ghost" type="submit"><i class="bi bi-archive me-2"></i>Архивтеу</button>
            </form>
        </div>
        <hr class="my-4" />
        <h3 class="h5 fw-bold">Тегтер</h3>
        @foreach (var tag in Model.Tags)
        {
            <span class="badge-soft me-2 mb-2">#@tag.Name</span>
        }
    </article>

    <aside class="premium-card">
        <h3 class="h5 fw-bold">Өзгерістер тарихы</h3>
        <div class="timeline mt-4">
            @foreach (var version in Model.Versions.OrderByDescending(x => x.CreatedAt))
            {
                <div class="timeline-item">
                    <div class="fw-bold">v@version.Version · @version.ChangeNote</div>
                    <div class="muted small">@version.CreatedBy?.FullName · @version.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </div>
            }
        </div>
    </aside>
</div>
