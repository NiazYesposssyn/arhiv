@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Support Center";
}

<div class="feature-grid">
    <div class="glass-card card-rich">
        <div class="card-icon"><i class="bi bi-book"></i></div>
        <h4>Knowledge base</h4>
        <p class="text-muted">Инструкции по документам, заявкам, экспорту, API и ролям доступа.</p>
    </div>
    <div class="glass-card card-rich">
        <div class="card-icon"><i class="bi bi-ticket-perforated"></i></div>
        <h4>Support tickets</h4>
        <p class="text-muted">Создание обращения в поддержку с приоритетом и SLA.</p>
    </div>
    <div class="glass-card card-rich">
        <div class="card-icon"><i class="bi bi-chat-dots"></i></div>
        <h4>Live assistant</h4>
        <p class="text-muted">Центр помощи для пользователей, архивариусов и администраторов.</p>
    </div>
</div>
