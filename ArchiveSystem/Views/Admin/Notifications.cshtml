@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Notifications";
}

<div class="feature-grid">
    <div class="glass-card card-rich">
        <div class="card-icon"><i class="bi bi-envelope"></i></div>
        <h4>Email уведомления</h4>
        <p class="text-muted">Подтверждения заявок, смена статуса, восстановление пароля и отчеты.</p>
        <button class="btn btn-soft" data-toast="Email тест жіберілді">Send test</button>
    </div>
    <div class="glass-card card-rich">
        <div class="card-icon"><i class="bi bi-phone-vibrate"></i></div>
        <h4>Push уведомления</h4>
        <p class="text-muted">Мгновенные события для пользователей и операторов личного кабинета.</p>
        <button class="btn btn-soft" data-toast="Push тест дайын">Send push</button>
    </div>
    <div class="glass-card card-rich">
        <div class="card-icon"><i class="bi bi-bell"></i></div>
        <h4>Notification Center</h4>
        <p class="text-muted">Единая лента уведомлений с фильтрацией по типу и статусу прочтения.</p>
        <button class="btn btn-premium" data-toast="Toast хабарламасы көрсетілді">Show toast</button>
    </div>
</div>
