@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
}

<section class="table-panel">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
        <div>
            <span class="eyebrow">Identity</span>
            <h3 class="mt-2 mb-0">Пайдаланушылар</h3>
        </div>
        <button class="btn btn-premium" data-toast="Пайдаланушы шақыруы дайын">Invite user</button>
    </div>
    <div class="table-responsive">
        <table class="premium-table">
            <thead><tr><th>Аты</th><th>Email</th><th>Рөл</th><th>2FA</th><th>Статус</th></tr></thead>
            <tbody>
                <tr><td>AAS Administrator</td><td>admin@archive.kz</td><td>Администратор</td><td>Enabled</td><td><span class="badge-soft">Active</span></td></tr>
                <tr><td>Archive Operator</td><td>operator@archive.kz</td><td>Архивариус</td><td>Enabled</td><td><span class="badge-soft">Active</span></td></tr>
                <tr><td>Citizen User</td><td>user@archive.kz</td><td>Пользователь</td><td>Optional</td><td><span class="badge-soft">Pending</span></td></tr>
            </tbody>
        </table>
    </div>
</section>
