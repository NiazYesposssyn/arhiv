@{
    ViewData["Title"] = "FAQ";
    var faqs = new[] {
        new { Category = "Құжаттар", Question = "Қандай файл түрлері қолданылады?", Answer = "PDF, DOCX, XLSX, JPG және PNG файлдарын тіркеуге болады." },
        new { Category = "Сұраныстар", Question = "Өтінім статусын қалай көремін?", Answer = "Жеке кабинеттегі Requests бөлімінде статус, комментарий және тарих көрсетіледі." },
        new { Category = "Қауіпсіздік", Question = "Жүйеде қандай қорғаныс бар?", Answer = "JWT authentication, рөлдер, 2FA, audit logs және резервтік көшіру бар." },
        new { Category = "Тарифтер", Question = "Мемлекеттік ұйымдарға жеке тариф бар ма?", Answer = "Иә, SLA, жеке контур және backup policy бар enterprise-пакет ұсынылады." }
    };
}

<section class="page-hero">
    <div class="container-page">
        <span class="eyebrow"><i class="bi bi-question-circle"></i> FAQ</span>
        <h1 class="page-title mt-3">Жиі қойылатын сұрақтар</h1>
        <p class="page-description">Поиск по вопросам, категории и раскрывающиеся ответы.</p>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container-page">
        <div class="faq-search mb-4">
            <i class="bi bi-search"></i>
            <input class="form-control" data-faq-search placeholder="Сұрақты іздеу..." />
        </div>
        <div class="accordion" id="faqAccordion">
            @for (var i = 0; i < faqs.Length; i++)
            {
                <div class="accordion-item glass-card mb-3" data-faq-item>
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-@i">
                            <span class="badge-soft me-3">@faqs[i].Category</span> @faqs[i].Question
                        </button>
                    </h2>
                    <div id="faq-@i" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">@faqs[i].Answer</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
