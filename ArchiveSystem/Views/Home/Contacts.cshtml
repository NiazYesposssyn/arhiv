@{
    ViewData["Title"] = "Контакты";
}

<section class="page-hero">
    <div class="container-page">
        <span class="eyebrow"><i class="bi bi-geo-alt"></i> Contacts</span>
        <h1 class="page-title mt-3">Байланыс</h1>
        <p class="page-description">Карта, email, телефон, адрес и форма обратной связи.</p>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container-page">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="map-card card-rich h-100">
                    <span class="eyebrow text-white-50">Astana HQ</span>
                    <h3 class="mt-2">Қазақстан архив орталығы</h3>
                    <p>Астана, Мәңгілік Ел даңғылы, 55</p>
                    <p class="mb-0"><i class="bi bi-envelope me-2"></i>support@archive.kz<br><i class="bi bi-telephone me-2"></i>+7 7172 55 55 55</p>
                </div>
            </div>
            <div class="col-lg-6">
                <form class="form-panel h-100">
                    <h3>Форма обратной связи</h3>
                    <div class="row g-3 mt-1">
                        <div class="col-sm-6"><input class="form-control" placeholder="Атыңыз" /></div>
                        <div class="col-sm-6"><input class="form-control" placeholder="Email" /></div>
                        <div class="col-12"><input class="form-control" placeholder="Тақырып" /></div>
                        <div class="col-12"><textarea class="form-control" rows="5" placeholder="Хабарлама"></textarea></div>
                        <div class="col-12"><button class="btn btn-premium" type="button" data-toast="Хабарлама жіберілді">Жіберу</button></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
