@{
    ViewData["Title"] = "Справочный центр";
}

<section class="page-hero">
    <div class="container-page">
        <span class="eyebrow"><i class="bi bi-life-preserver"></i> Help Center</span>
        <h1 class="page-title mt-3">Справочный центр</h1>
        <p class="page-description">База знаний для пользователей, архивариусов и администраторов.</p>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container-page">
        <div class="feature-grid">
            <div class="glass-card card-rich">
                <div class="card-icon"><i class="bi bi-upload"></i></div>
                <h4>Құжат жүктеу</h4>
                <p class="text-muted">Инструкция по drag and drop, форматам файлов, категориям и генерации номера документа.</p>
            </div>
            <div class="glass-card card-rich">
                <div class="card-icon"><i class="bi bi-inbox"></i></div>
                <h4>Өтінімдер</h4>
                <p class="text-muted">Как создать заявку, проверить статус, прочитать комментарии и экспортировать историю.</p>
            </div>
            <div class="glass-card card-rich">
                <div class="card-icon"><i class="bi bi-shield-check"></i></div>
                <h4>Security guide</h4>
                <p class="text-muted">JWT token, 2FA, роли, аудит, push/email уведомления и резервные копии.</p>
            </div>
        </div>
    </div>
</section>
