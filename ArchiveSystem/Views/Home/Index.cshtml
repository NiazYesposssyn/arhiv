@{
    ViewData["Title"] = "Басты бет";
}

<section class="page-hero">
    <div class="container-page hero-grid">
        <div class="animate-up">
            <span class="eyebrow"><i class="bi bi-stars"></i> Premium SaaS Archive Platform</span>
            <h1 class="hero-title mt-3">Электрондық мұрағат басқару жүйесі</h1>
            <p class="hero-copy">Құжаттарды сақтау, іздеу және архивтік сұраныстарды автоматтандыруға арналған заманауи цифрлық платформа</p>
            <div class="hero-actions">
                <a class="btn btn-premium btn-lg" asp-controller="Auth" asp-action="Register">Жүйені бастау</a>
                <a class="btn btn-ghost btn-lg" asp-controller="Auth" asp-action="Login"><i class="bi bi-play-circle me-2"></i>Демо көру</a>
            </div>
        </div>
        <div class="hero-visual" aria-label="Archive illustration">
            <div class="visual-card main">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="eyebrow text-white-50">Archive cloud</span>
                        <h3 class="fw-black mt-2">Secure document vault</h3>
                    </div>
                    <i class="bi bi-cloud-check fs-1"></i>
                </div>
                <div class="server-rack">
                    <div class="server-row"><span><i class="bi bi-hdd-network me-2"></i>Server cluster</span><strong>99.9%</strong></div>
                    <div class="server-row"><span><i class="bi bi-file-earmark-pdf me-2"></i>PDF / DOCX / XLSX</span><strong>2.4M</strong></div>
                    <div class="server-row"><span><i class="bi bi-graph-up-arrow me-2"></i>Analytics stream</span><strong>Live</strong></div>
                </div>
            </div>
            <div class="visual-card floating-one">
                <i class="bi bi-archive fs-2"></i>
                <h6 class="mt-3 mb-0">Digital archive</h6>
            </div>
            <div class="visual-card floating-two">
                <i class="bi bi-bar-chart-line fs-2"></i>
                <h6 class="mt-3 mb-0">AI search insights</h6>
            </div>
        </div>
    </div>
</section>

<section class="section-shell">
    <div class="container-page">
        <div class="glass-card card-rich">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="eyebrow">Enterprise ready</span>
                    <h2 class="mt-2 fw-bold">Басты бет тек презентациялық шолу береді.</h2>
                    <p class="text-muted mb-0">Толық ақпарат жоғарғы мәзірдегі жеке беттерде орналасқан: архив, қызметтер, тарифтер, FAQ, байланыс және жеке кабинет.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="btn btn-premium" asp-controller="Home" asp-action="AboutSystem">Платформаны қарау</a>
                </div>
            </div>
        </div>
    </div>
</section>
