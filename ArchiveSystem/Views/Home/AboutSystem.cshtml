@{
    ViewData["Title"] = "О системе";
}

<section class="page-hero">
    <div class="container-page">
        <span class="eyebrow"><i class="bi bi-cpu"></i> Intelligent archive platform</span>
        <h1 class="page-title mt-3">Платформа для управления архивными документами</h1>
        <p class="page-description">Archive Access System объединяет хранение, поиск, обработку заявок, аналитику, безопасность и интеграции в едином enterprise-интерфейсе.</p>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container-page">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6">
                <img class="rich-img h-100" src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=80" alt="Modern office dashboard" />
            </div>
            <div class="col-lg-6">
                <div class="glass-card card-rich h-100">
                    <span class="eyebrow">Назначение</span>
                    <h2 class="mt-2">Единое цифровое окно архива</h2>
                    <p class="text-muted">Система помогает архивариусам регистрировать документы, отслеживать версии, выдавать архивные справки и отвечать на запросы граждан и организаций.</p>
                    <div class="row g-3 mt-3">
                        <div class="col-sm-6"><div class="skeleton"></div></div>
                        <div class="col-sm-6"><div class="skeleton"></div></div>
                        <div class="col-sm-8"><div class="skeleton"></div></div>
                        <div class="col-sm-4"><div class="skeleton"></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="feature-grid mt-4">
            <div class="glass-card card-rich">
                <div class="card-icon"><i class="bi bi-shield-lock"></i></div>
                <h4>Безопасность</h4>
                <p class="text-muted">JWT, role-based access, 2FA, журнал аудита, IP-логирование и резервное копирование.</p>
            </div>
            <div class="glass-card card-rich">
                <div class="card-icon"><i class="bi bi-search"></i></div>
                <h4>Интеллектуальный поиск</h4>
                <p class="text-muted">Фильтрация по региону, типу файла, статусу, номеру документа, категории и периоду.</p>
            </div>
            <div class="glass-card card-rich">
                <div class="card-icon"><i class="bi bi-diagram-3"></i></div>
                <h4>Процессы</h4>
                <p class="text-muted">Заявки, комментарии администратора, уведомления, отчеты и экспорт данных.</p>
            </div>
        </div>
    </div>
</section>
