{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Запустить сайт ЦГА ВКО",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/portal/start.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/portal"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
